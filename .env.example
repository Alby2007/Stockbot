# Copy to .env and fill in. Never commit the real .env file.

# Postgres connection string used by all services and by tests.
# Local docker-compose default (host port 5450: pick a port not already used
# by any Postgres running natively on the host, e.g. `netstat -ano | findstr
# LISTENING` on Windows):
DATABASE_URL=postgresql://stockbot:stockbot@localhost:5450/stockbot

# Separate database for the test suite so tests never touch dev/prod data.
# Point this at a throwaway database (a local docker Postgres or a scratch
# Supabase project both work).
TEST_DATABASE_URL=postgresql://stockbot:stockbot@localhost:5450/stockbot_test

# Postgres password for the docker-compose database. Set a real one for any
# deployed instance BEFORE the first boot -- Postgres applies it only when
# initializing an empty data dir. The services' internal DATABASE_URLs derive
# from this; DATABASE_URL above is only for running outside docker.
POSTGRES_PASSWORD=stockbot

# Discord bot token (bot service only).
DISCORD_TOKEN=

# HMAC seed used to derive per-tick RNG seeds deterministically (market
# service). MUST be a real secret in production -- the entire price history
# is derived from it, and it cannot be rotated without forking history.
MASTER_SEED=change-me-in-production

# Comma-separated Discord user ids allowed to run /admin commands (bot service only).
ADMIN_USER_IDS=
